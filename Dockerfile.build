# Multi-stage Dockerfile for ACR pushes from a developer machine.
# The release pipeline uses the slim Dockerfile (which expects pre-built
# binaries from the GitHub Actions matrix). This file compiles cyweb
# from source inside the image so a developer can `docker buildx build`
# from a clean checkout without depending on the GHA artifact pipeline.

# ── Builder stage ───────────────────────────────────────────────────────
FROM rust:slim-bookworm AS builder

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY rules ./rules
COPY payloads ./payloads

RUN cargo build --release --locked --bin cyweb \
 && strip target/release/cyweb

# ── Runtime stage ───────────────────────────────────────────────────────
FROM debian:trixie-slim

# The AJAX spider drives a headless browser over CDP (chromiumoxide). We do
# NOT use the distro Chromium as the browser — trixie ships Chromium 155, whose
# CDP protocol is far newer than chromiumoxide's generated bindings can parse
# ("data did not match any variant of untagged enum Message" → every command
# hangs). Instead we pin a Chrome-for-Testing build matched to the CDP lib and
# install the distro `chromium` ONLY for its shared-library dependency closure
# (libnss3 / libgbm1 / libasound2t64 / fonts / …), which the pinned Chrome
# links against — avoiding a hand-maintained, trixie-t64-renamed lib list.
ARG CHROME_VERSION=136.0.7103.94
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        chromium \
        wget \
        unzip \
 && wget -q "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-linux64.zip" -O /tmp/chrome.zip \
 && unzip -q /tmp/chrome.zip -d /opt \
 && rm /tmp/chrome.zip \
 && apt-get purge -y wget unzip \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* \
 && /opt/chrome-linux64/chrome --version

WORKDIR /opt/cyweb

COPY --from=builder /build/target/release/cyweb /usr/local/bin/cyweb
RUN chmod +x /usr/local/bin/cyweb \
 && /usr/local/bin/cyweb version

COPY payloads /opt/cyweb/payloads
COPY rules    /opt/cyweb/rules

ENV CYWEB_PAYLOADS_DIR=/opt/cyweb/payloads \
    CYWEB_RULES_DIR=/opt/cyweb/rules \
    CYWEB_CHROME_PATH=/opt/chrome-linux64/chrome

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cyweb"]
CMD ["--help"]
